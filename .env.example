# Copy to .env.local and replace placeholders with real values.
VITE_SUPABASE_URL=__REPLACE_ME__
VITE_SUPABASE_ANON_KEY=__REPLACE_ME__

# Server-only Vercel Function variables. Never prefix the secret with VITE_.
SUPABASE_URL=__REPLACE_ME__
SUPABASE_SECRET_KEY=__SERVER_ONLY_REPLACE_ME__

# Legacy alternative to SUPABASE_SECRET_KEY (set one, not both):
# SUPABASE_SERVICE_ROLE_KEY=__SERVER_ONLY_REPLACE_ME__
